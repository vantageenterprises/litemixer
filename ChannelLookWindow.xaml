<Window x:Class="LiteMixer.ChannelLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- Icon cells and color swatches; the selected one gets a bright border. -->
        <Style x:Key="PickCell" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="{StaticResource WellBg}"/>
            <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,16,22,20">
        <!-- Live preview -->
        <Grid Height="42" Background="{StaticResource HeaderBg}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="PreviewGlyph" FontFamily="{StaticResource IconFont}" FontSize="17" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock x:Name="PreviewName" FontSize="15" FontWeight="Bold" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="ICON" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SoftTextBrush}" Margin="0,16,0,8"/>
        <UniformGrid x:Name="IconGrid" Columns="10" Margin="0,0,-4,-4"/>

        <TextBlock Text="COLOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SoftTextBrush}" Margin="0,16,0,8"/>

        <!-- Saturation left to right, brightness bottom to top -->
        <Grid x:Name="ShadeArea" Height="110" ClipToBounds="True" Cursor="Cross" Background="Transparent"
              MouseLeftButtonDown="Shade_Down" MouseMove="Shade_Move" MouseLeftButtonUp="Picker_Up">
            <Border x:Name="ShadeHue" IsHitTestVisible="False"/>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FF000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="ShadeThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2"/>
            </Canvas>
        </Grid>

        <!-- Hue -->
        <Grid x:Name="HueArea" Height="14" Margin="0,8,0,0" Cursor="SizeWE" ClipToBounds="True"
              MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Picker_Up">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF0000" Offset="0"/>
                    <GradientStop Color="#FFFF00" Offset="0.1667"/>
                    <GradientStop Color="#00FF00" Offset="0.3333"/>
                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                    <GradientStop Color="#0000FF" Offset="0.6667"/>
                    <GradientStop Color="#FF00FF" Offset="0.8333"/>
                    <GradientStop Color="#FF0000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="HueThumb" Width="6" Height="14" Fill="White" Stroke="#14171C" StrokeThickness="1"/>
            </Canvas>
        </Grid>

        <!-- Swatches and hex -->
        <UniformGrid x:Name="SwatchGrid" Columns="10" Margin="0,12,-4,0"/>
        <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Hex" FontSize="12" Foreground="{StaticResource SoftTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="HexInput" Width="104" Height="34" Padding="10,6" MaxLength="7" FontSize="13" TextChanged="Hex_TextChanged" LostFocus="Hex_LostFocus"/>
            <TextBlock x:Name="ReadHint" Text="Hard to read on the dark background." FontSize="11.5" Foreground="#F0A35A"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>
        </DockPanel>

        <DockPanel Margin="0,18,0,0">
            <Button Style="{StaticResource TextButton}" Content="Reset to default" Height="32" Click="Reset_Click" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource TextButton}" Content="Cancel" Height="32" Click="Cancel_Click"/>
                <Button Style="{StaticResource AccentButton}" Content="Save" Height="32" Margin="8,0,0,0" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
