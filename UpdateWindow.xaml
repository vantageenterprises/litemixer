<Window x:Class="LiteMixer.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiteMixer update"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowActivated="False"
        Background="{StaticResource PanelBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <StackPanel Margin="22,18,22,20">
        <TextBlock x:Name="Headline" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock x:Name="Current" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,3,0,0"/>

        <Border x:Name="NotesBox" Background="{StaticResource WellBg}" CornerRadius="4" Margin="0,14,0,0" Padding="12,10">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Notes" FontSize="12.5" Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
            </ScrollViewer>
        </Border>

        <TextBlock Text="LiteMixer closes briefly while it updates. Your audio keeps playing and your settings stay."
                   FontSize="11.5" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource TextButton}" Content="Later" Height="32" Click="Later_Click"/>
            <Button Style="{StaticResource AccentButton}" Content="Update now" Height="32" Margin="8,0,0,0" Click="Update_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
