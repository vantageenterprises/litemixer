<Window x:Class="LiteMixer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LiteMixer"
        Title="LiteMixer Settings"
        Width="580" Height="720"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#9AA8FF"/>
            <Setter Property="Margin" Value="0,22,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,4,22,24">

            <!-- Hotkeys -->
            <TextBlock Text="HOTKEYS" Style="{StaticResource Section}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Work anywhere, including in games. Click a box and press the keys. Backspace clears it."/>
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding Hotkeys}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:HotkeyRow}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontSize="12.5"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#F0605A"
                                               Visibility="{Binding StatusVisibility}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding Display, Mode=OneWay}" IsReadOnly="True"
                                         IsReadOnlyCaretVisible="False" Cursor="Hand"
                                         PreviewKeyDown="Hotkey_KeyDown" GotKeyboardFocus="Hotkey_Focus"
                                         LostKeyboardFocus="Hotkey_Blur"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Safety -->
            <TextBlock Text="VOLUME SAFETY" Style="{StaticResource Section}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="A cap is the highest a fader can go (shown as a red line on the fader). 100% means no cap."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Caps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CapRow}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{Binding Accent}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    <Slider Grid.Column="1" Style="{StaticResource PlainSlider}" Minimum="5" Maximum="100"
                                            Value="{Binding Value, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{StaticResource SoftTextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="Fade in big volume jumps instead of jumping straight up" Margin="0,10,0,2"
                              IsChecked="{Binding FadeIn, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- New apps -->
            <TextBlock Text="NEW APPS" Style="{StaticResource Section}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Games go to Game, and common chat, music and video apps go to their channels. Anything else opens in your default channel. An app you move yourself stays where you put it. Apps using your microphone follow the Mic channel's device."/>
            <Border Style="{StaticResource Card}">
                <CheckBox Content="Sort new apps automatically" IsChecked="{Binding AutoSortApps, Mode=TwoWay}"/>
            </Border>

            <!-- Auto-duck -->
            <TextBlock Text="AUTO-DUCK" Style="{StaticResource Section}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Turns the chosen channels down while someone is talking in the Chat channel, then brings them back."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Duck while chat is talking" IsChecked="{Binding DuckEnabled, Mode=TwoWay}"/>
                    <Grid Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Lower to" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Style="{StaticResource PlainSlider}" Minimum="5" Maximum="95"
                                Value="{Binding DuckLevel, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Text="{Binding DuckLevelText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{StaticResource SoftTextBrush}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DuckChannels}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DuckRow}">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,0,18,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Mic -->
            <TextBlock Text="MIC" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Beep when the mic is muted or unmuted" IsChecked="{Binding MicBeep, Mode=TwoWay}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Beep volume" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Style="{StaticResource PlainSlider}" Minimum="1" Maximum="50"
                                Value="{Binding MicBeepVolume, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Text="{Binding MicBeepVolumeText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{StaticResource SoftTextBrush}"/>
                        <Button Grid.Column="3" Style="{StaticResource TextButton}" Content="Test" Margin="12,0,0,0"
                                Click="TestBeep_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="The tray icon turns red while the mic is muted. Middle-click the tray icon to mute or unmute."/>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <TextBlock Text="UPDATES" Style="{StaticResource Section}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Asks GitHub once a day whether a newer version exists. Nothing about you or your audio is sent, and nothing installs until you say so."/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox Content="Check for updates automatically" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding UpdateStatus}" FontSize="11.5" Margin="24,5,0,0"
                                   Foreground="{StaticResource DimBrush}"/>
                    </StackPanel>
                    <Button Style="{StaticResource TextButton}" Content="Check now" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="CheckUpdates_Click"/>
                </Grid>
            </Border>

            <!-- Hidden apps -->
            <TextBlock Text="HIDDEN APPS" Style="{StaticResource Section}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Hidden apps still follow their channel's volume; they are just not shown. Right-click an app in the mixer to hide it."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Nothing hidden." Foreground="{StaticResource DimBrush}"
                               Visibility="{Binding NoHiddenVisibility}"/>
                    <ItemsControl ItemsSource="{Binding Hidden}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HiddenRow}">
                                <Grid Margin="0,3">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource TextButton}" Content="Show" HorizontalAlignment="Right"
                                            Click="Unhide_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Profiles -->
            <TextBlock Text="PROFILES" Style="{StaticResource Section}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Save every fader, mute and Game / Chat balance as a one-click setup. Apply them here, from the menu, or from the tray."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProfileName" KeyDown="ProfileName_KeyDown"/>
                        <TextBlock Text="Name, for example Gaming or Late night" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource DimBrush}" FontSize="12"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ProfileName}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="Save current mix"
                                Margin="10,0,0,0" Click="SaveProfile_Click"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:MixProfile}">
                                <Grid Margin="0,3">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource TextButton}" Content="Apply" Click="ApplyProfile_Click"/>
                                        <Button Style="{StaticResource TextButton}" Content="Delete" Margin="8,0,0,0"
                                                Click="DeleteProfile_Click"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
