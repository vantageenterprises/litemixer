<Window x:Class="LiteMixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LiteMixer"
        Title="LiteMixer"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <DataTemplate x:Key="ChannelTemplate" DataType="{x:Type local:ChannelVM}">
            <Grid Width="178">
            <Border Background="{StaticResource PanelBg}">
                <StackPanel>
                    <!-- Header -->
                    <Grid Height="42" Background="{StaticResource HeaderBg}" ToolTip="{Binding HeaderTip}"
                          MouseLeftButtonDown="Header_Down">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanMove}" Value="True">
                                        <Setter Property="Cursor" Value="SizeWE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,0,16,0">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" MaxWidth="96"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Accent}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" HorizontalAlignment="Right"
                                Margin="0,0,9,0" Click="Gear_Click" ToolTip="Channel options" Cursor="Arrow"/>
                    </Grid>

                    <!-- Device row -->
                    <Button Style="{StaticResource DeviceRowButton}" Click="Device_Click"
                            PreviewMouseWheel="Device_Wheel" ToolTip="{Binding DeviceTooltip}">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DeviceGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SoftTextBrush}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Fader and level meter -->
                    <Grid Height="250" Margin="0,18,0,0">
                        <!-- Safety cap: the fader cannot go above this line -->
                        <Border Width="24" Height="2" Background="#F0605A" VerticalAlignment="Top"
                                HorizontalAlignment="Center" Margin="{Binding CapMarkerMargin}"
                                Visibility="{Binding CapVisibility}" IsHitTestVisible="False"
                                ToolTip="Volume cap"/>
                        <Slider Style="{StaticResource FaderSlider}" Value="{Binding Volume, Mode=TwoWay}"
                                HorizontalAlignment="Center" PreviewMouseWheel="Fader_Wheel"/>
                        <Border Width="3" HorizontalAlignment="Center" Margin="30,12,0,12"
                                CornerRadius="1.5" IsHitTestVisible="False">
                            <Rectangle Fill="{Binding Accent}" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="{Binding Peak}"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding VolumeText}" FontSize="11" Foreground="{StaticResource DimBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding Muted, Mode=TwoWay}"
                                  HorizontalAlignment="Center" Margin="0,6,0,0" ToolTip="Mute"/>

                    <!-- Apps -->
                    <TextBlock Text="{Binding AppsLabel}" FontSize="12" Foreground="{StaticResource DimBrush}"
                               Margin="10,16,10,5"/>
                    <Border Height="128" Margin="8,0,8,10" Background="{StaticResource WellBg}" CornerRadius="4"
                            BorderThickness="1" BorderBrush="Transparent" AllowDrop="{Binding AcceptsDrop}"
                            DragEnter="Well_DragOver" DragOver="Well_DragOver" DragLeave="Well_DragLeave" Drop="Well_Drop">
                        <Grid>
                        <TextBlock Text="{Binding EmptyHint}" FontSize="11.5" Foreground="{StaticResource DimBrush}"
                                   TextWrapping="Wrap" Margin="10,8" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="8,8,4,4">
                            <ItemsControl ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:AppChip}">
                                        <Border CornerRadius="3" Padding="6,3,7,3" Margin="0,0,5,5" Cursor="Hand"
                                                ToolTip="{Binding Name}"
                                                Background="{Binding DataContext.ChipBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                PreviewMouseLeftButtonDown="Chip_Down" MouseMove="Chip_Move"
                                                MouseRightButtonUp="Chip_Menu">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,5,0"
                                                       Visibility="{Binding IconVisibility}" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Display}" FontSize="10.5" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="122" VerticalAlignment="Center"
                                                           Foreground="{Binding DataContext.ChipForeground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <!-- Flashes when the Channels menu jumps here -->
            <Border x:Name="FlashRing" BorderBrush="{Binding Accent}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16,6,16,16">
        <!-- Top bar -->
        <Grid DockPanel.Dock="Top" Height="46">
        <!-- Only visible while an update is available -->
        <Button x:Name="UpdateBanner" Style="{StaticResource AccentButton}" Height="30" HorizontalAlignment="Left"
                VerticalAlignment="Center" Content="{Binding BannerText}" Visibility="{Binding BannerVisibility}"
                Click="UpdateBanner_Click" ToolTip="See what's new and update"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource TextButton}" Height="30" VerticalAlignment="Center" Margin="0,0,6,0"
                    Click="ChannelMenu_Click" ToolTip="Jump to a channel">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Channels" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,1,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SquareButton}" Content="&#xE710;" VerticalAlignment="Center" Margin="0,0,6,0"
                    Click="AddChannel_Click" ToolTip="Add a channel"/>
            <Button Style="{StaticResource SquareButton}" Content="&#xE700;" VerticalAlignment="Center"
                    Click="AppMenu_Click" ToolTip="Menu"/>
        </StackPanel>
        </Grid>

        <!-- Master and Mic stay put; everything between them scrolls sideways. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="MasterHost" Content="{Binding Master}" ContentTemplate="{StaticResource ChannelTemplate}"
                            VerticalAlignment="Top" Margin="0,0,4,0"/>

            <ScrollViewer x:Name="ChannelScroll" Grid.Column="1" Width="728" Margin="0,0,10,0"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowDrop="True"
                          PreviewDragOver="ChannelScroll_PreviewDragOver" DragOver="ChannelScroll_DragOver"
                          PreviewMouseWheel="ChannelScroll_Wheel">
                <StackPanel x:Name="ChannelStrip" HorizontalAlignment="Left">
                    <ItemsControl x:Name="ChannelList" ItemsSource="{Binding ScrollChannels}"
                                  ItemTemplate="{StaticResource ChannelTemplate}"
                                  MouseLeftButtonUp="ChannelList_MouseUp" LostMouseCapture="ChannelList_LostCapture">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,4,0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                    <!-- Balance sits under whichever of Game and Chat is further left, and follows them when they move -->
                    <Border Width="360" HorizontalAlignment="Left" Background="#262A31"
                            CornerRadius="0,0,6,6" Padding="14,8,14,10">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BalanceShift"/>
                        </Border.RenderTransform>
                        <StackPanel>
                            <TextBlock Text="GAME / CHAT" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{StaticResource SoftTextBrush}"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Game.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{Binding Game.Accent}" VerticalAlignment="Center" ToolTip="More game"/>
                                <Slider Grid.Column="1" Style="{StaticResource BalanceSlider}" Margin="12,0"
                                        Value="{Binding Balance, Mode=TwoWay}" MouseDoubleClick="Balance_Reset"
                                        PreviewMouseWheel="Balance_Wheel" ToolTip="Double-click to center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Chat.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{Binding Chat.Accent}" VerticalAlignment="Center" ToolTip="More chat"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ContentControl x:Name="MicHost" Grid.Column="2" Content="{Binding Mic}" ContentTemplate="{StaticResource ChannelTemplate}"
                            VerticalAlignment="Top"/>
        </Grid>
    </DockPanel>
</Window>
