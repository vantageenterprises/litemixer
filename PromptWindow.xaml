<Window x:Class="LiteMixer.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <StackPanel Margin="22,18,22,20">
        <TextBlock x:Name="Message" FontSize="12.5" Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap"/>
        <TextBox x:Name="Input" Margin="0,10,0,0" Height="36" Padding="10,7" MaxLength="24" FontSize="13" TextChanged="Input_TextChanged"/>
        <TextBlock x:Name="Problem" FontSize="11.5" Foreground="#F0605A" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource TextButton}" Content="Cancel" Height="32" Click="Cancel_Click"/>
            <Button x:Name="Accept" Style="{StaticResource AccentButton}" Height="32" Margin="8,0,0,0" Click="Accept_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
