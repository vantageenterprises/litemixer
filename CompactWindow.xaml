<Window x:Class="LiteMixer.CompactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LiteMixer"
        Title="LiteMixer Compact"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="MiniChannel" DataType="{x:Type local:ChannelVM}">
            <StackPanel Width="54" Margin="2,0">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{Binding Accent}" HorizontalAlignment="Center" ToolTip="{Binding DisplayName}"/>
                <Grid Height="120" Margin="0,6,0,0">
                    <Slider Style="{StaticResource FaderSlider}" Value="{Binding Volume, Mode=TwoWay}"
                            HorizontalAlignment="Center" PreviewMouseWheel="Fader_Wheel"/>
                    <Border Width="3" HorizontalAlignment="Center" Margin="30,12,0,12" IsHitTestVisible="False">
                        <Rectangle Fill="{Binding Accent}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleY="{Binding Peak}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding VolumeText}" FontSize="10.5" Foreground="{StaticResource DimBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding Muted, Mode=TwoWay}"
                              HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="#3A404A" BorderThickness="1">
        <StackPanel Margin="8,4,8,10">
            <!-- Drag handle -->
            <Grid Height="24" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="LITEMIXER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DimBrush}"
                           VerticalAlignment="Center" Margin="2,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="10" Content="&#xE8A7;"
                            Background="Transparent" Click="Open_Click" ToolTip="Open full mixer"/>
                    <Button Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="10" Content="&#xE8BB;"
                            Background="Transparent" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <ScrollViewer MaxWidth="348" Margin="0,4,0,0" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource MiniChannel}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <Grid Margin="4,10,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Game.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{Binding Game.Accent}"
                           VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Style="{StaticResource BalanceSlider}" Margin="8,0"
                        Value="{Binding Balance, Mode=TwoWay}" MouseDoubleClick="Balance_Reset"
                        PreviewMouseWheel="Balance_Wheel" ToolTip="Game / Chat balance (double-click to center)"/>
                <TextBlock Grid.Column="2" Text="{Binding Chat.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{Binding Chat.Accent}" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
